{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vodsnip",
  "version": "0.1.0",
  "identifier": "com.austintaylor.vodsnip.windows",
  "build": { "frontendDist": "../src" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Vodsnip",
        "width": 600,
        "height": 640,
        "minWidth": 520,
        "minHeight": 520,
        "resizable": true,
        "center": true
      }
    ],
    "security": { "csp": "default-src 'self'; img-src 'self' https: data:; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": { "bin-vendor/*": "bin/" },
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
